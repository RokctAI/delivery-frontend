# delivery-frontend (juvo) — environment variables this shell reads.
#
# Copy to .env.local for local development. Names only, never values: secrets
# live in the private RokctAI/occultation workspace and are set in the Vercel
# project's Environment Variables, not in this file.

# ---------------------------------------------------------------------------
# Public origin of this deployment.
# ---------------------------------------------------------------------------
# Read by base_sdk's app/lib/site-metadata.ts (composed): the metadataBase,
# the canonical URL and what the generated favicon and link preview take the
# domain's first letter and host line from. Ray, 2026-09-09: "deliveryplatform
# will be juvo so i will point juvo.app to it" - so the production value is
# https://juvo.app; delivery_sdk's site metadata carries the same url as the
# fallback when this is unset.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# The control site.
# ---------------------------------------------------------------------------
# Base origin of the Frappe CONTROL site this shell points at. Read by the
# base_sdk platform client (core/base/nextjs/src/services/platform-gateway.ts),
# which appends the single gateway path /api/v1/method/rokct.platform.api and
# names the target method in the request's `cmd` field; the landing's plan
# rows (delivery_sdk filters the shared catalog to plan_category "paas" on
# the server) and the host's own gateway libs (app/lib/gateway-rpc.ts,
# app/services/common/base.ts) go through it. Server-side value first, public
# fallback second. Neither is read at build time.
ROKCT_BASE_URL=
NEXT_PUBLIC_ROKCT_BASE_URL=

# ---------------------------------------------------------------------------
# Tenant hosts (base_sdk kernel, app/services/base/tenant-hosts.ts).
# ---------------------------------------------------------------------------
# A tenant's own domain opens the portal login (auth_sdk >= 1.7.0's
# tenant-host middleware; delivery_sdk's root route). ROKCT_TENANT_HOSTS is
# the static host -> site map; ROKCT_TENANT_HOST_LOOKUP selects a registered
# resolver instead; the two TTLs tune the resolver's cache. All optional:
# unset, unknown and preview hosts get the storefront.
ROKCT_TENANT_HOSTS=
ROKCT_TENANT_HOST_LOOKUP=
ROKCT_TENANT_HOST_TTL_MS=
ROKCT_TENANT_HOST_NEGATIVE_TTL_MS=

# ---------------------------------------------------------------------------
# auth_sdk (composed; RokctAI/Users auth/nextjs).
# ---------------------------------------------------------------------------
# NextAuth signing secret. Not read at build time; required at runtime by the
# composed /api/auth/[...nextauth] handler and by every session read.
AUTH_SECRET=

# This shell serves MANY tenant backends (the portal a tenant's own domain
# opens), so auth_sdk's default "database" tenant link applies: login looks
# the user's tenant site up in the local Postgres store auth_sdk installs
# (db/, lib/drizzle, drizzle.config.ts). Runtime and `drizzle-kit migrate`
# only; nothing here is read at build time.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# ---------------------------------------------------------------------------
# Try-it block on the storefront's apps section (delivery_sdk >= 1.0.0,
# components/custom/landing/delivery-apps.ts).
# ---------------------------------------------------------------------------
# Inlined at BUILD time (NEXT_PUBLIC_). The block hides itself for any app
# whose login is unset; no demo account is seeded anywhere - an operator marks
# one real account per role is_demo_account on the site named here and sets
# these six where the shell is built.
NEXT_PUBLIC_JUVO_DEMO_SITE=
NEXT_PUBLIC_JUVO_DEMO_CUSTOMER_LOGIN=
NEXT_PUBLIC_JUVO_DEMO_CUSTOMER_PASSWORD=
NEXT_PUBLIC_JUVO_DEMO_MANAGER_LOGIN=
NEXT_PUBLIC_JUVO_DEMO_MANAGER_PASSWORD=
NEXT_PUBLIC_JUVO_DEMO_DRIVER_LOGIN=
NEXT_PUBLIC_JUVO_DEMO_DRIVER_PASSWORD=
